# Django: replace these placeholders locally; never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
ALLOWED_HOSTS=localhost,127.0.0.1
# For a custom domain, use its HTTPS origin (comma-separated if needed).
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN

# Public uploads (Supabase S3-compatible storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_STORAGE_BUCKET=media
AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=YOUR_REGION
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
# Create this as a PRIVATE Supabase bucket before music uploads are enabled.
MUSIC_STORAGE_PROVIDER=supabase
MUSIC_STORAGE_BUCKET=music-private
# For Cloudflare music storage, set MUSIC_STORAGE_PROVIDER=r2 and fill these.
# Keep the AWS_* variables above for public Supabase media.
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION_NAME=auto
# Optional override for a different public CDN:
# SUPABASE_PUBLIC_MEDIA_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/media/

# Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
